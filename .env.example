# Copy to .env and fill in locally. NEVER commit .env. Every value here is a placeholder.

# --- run mode ---
# true  = no credentials needed: data from data/sample (DuckDB), LLM answers replayed from
#         recorded cassettes (labelled REPLAY). Deterministic logic always runs for real.
# false = live data through Zetaris, live LLM calls.
SAMPLE_MODE=true
# true together with SAMPLE_MODE=true: run the sample data against the live models and record
# their answers into data/sample/llm_cassette.jsonl (done once by Member D, then committed)
RECORD_LLM=false
# YYYY-MM-DD; empty means "latest date available in the data"
TRADEPULSE_AS_OF=

# --- data providers (public, no keys; they require a contact User-Agent) ---
# SEC EDGAR wants "app_name contact@domain"
SEC_USER_AGENT="tradepulse-dev contact@example.com"
WIKIMEDIA_USER_AGENT="tradepulse-dev (contact@example.com)"

# --- Zetaris (sponsor) ---
# Create the API key yourself in the Zetaris GUI (Management -> API Tokens).
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_BASE_URL=http://localhost:3000
ZETARIS_ORG_ID=
ZETARIS_API_KEY=
ZETARIS_USER_AGENT="tradepulse contact@example.com"

# --- Meterless (sponsor) ---
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
# path to <stateDir>/proxy-token written by Nightshift; the token itself is never stored here
METERLESS_TOKEN_FILE=
METERLESS_APP=tradepulse
METERLESS_MODEL=meterless/fast
# Node sidecar that hosts the World Model and H-MEM reference engines
ENGINES_URL=http://127.0.0.1:8790
# required for the shared AWS sidecar (see integrations/ACCESS.md); leave empty for local docker-compose
ENGINES_TOKEN=

# --- NVIDIA NIM (hosted LLMs for explain / skeptic roles) ---
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_ANALYST_MODEL=
NIM_SKEPTIC_MODEL=

# --- web ---
# empty = the web app loads contracts/fixtures (shown with a SYNTHETIC FIXTURE banner)
VITE_API_BASE=
