{
  "name": "tradepulse-meterless-engines",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "tsx src/server.ts",
    "test": "vitest run",
    "check": "tsc --noEmit",
    "verify:vendor": "node scripts/verify-vendor.mjs",
    "conformance:hmem": "tsx vendor/hmem/conformance/runner.ts",
    "conformance:world-model": "tsx vendor/world-model/conformance/runner.ts",
    "conformance": "npm run verify:vendor && npm run conformance:hmem && npm run conformance:world-model"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
